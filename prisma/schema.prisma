generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Admin {
  id           String   @id @default(cuid())
  name         String
  username     String   @unique
  passwordHash String
  role         String   @default("super_admin")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?   @db.Text
  icon        String?   @default("Crosshair")
  image       String?   @db.Text
  sortOrder   Int       @default(0)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id            String      @id @default(cuid())
  name          String
  slug          String      @unique
  sku           String?     @unique
  price         Int
  discountPrice Int?
  stock         Int         @default(10)
  categoryId    String
  category      Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  mainImage     String      @db.Text
  galleryImages String?     @db.Text // JSON array of strings
  description   String      @db.Text
  caliber       String?     @default("4.5 mm / .177")
  tubeCapacity  String?     // e.g. "500 cc Dural"
  maxPressure   String?     // e.g. "3000 PSI / Safe 2700 PSI"
  barrelLength  String?     // e.g. "60 cm Baja Seamless Od 13"
  stockMaterial String?     // e.g. "Kayu Mahoni / Popor Dural Lipat"
  isFeatured    Boolean     @default(false)
  isActive      Boolean     @default(true)
  views         Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  orderItems    OrderItem[]
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  customerName    String
  customerPhone   String
  customerAddress String      @db.Text
  notes           String?     @db.Text
  subtotal        Int
  totalAmount     Int
  status          String      @default("PENDING") // PENDING, CONFIRMED, COMPLETED, CANCELLED
  whatsappSent    Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  items           OrderItem[]
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String
  price       Int
  quantity    Int
  subtotal    Int
  createdAt   DateTime @default(now())
}

model StoreSetting {
  id               String   @id @default(cuid())
  storeName        String   @default("UD. Jaya Senapan Angin")
  tagline          String   @default("Pusat Senapan Angin, Aksesoris & Servis Terpercaya di Jombang")
  whatsappNumber   String   @default("6285806854227")
  address          String   @default("Jl. Raya Tembelang No. 45, Kec. Tembelang, Kab. Jombang, Jawa Timur")
  city             String   @default("Jombang")
  operationalHours String   @default("Senin - Sabtu: 08.00 - 17.00 WIB")
  googleMapsUrl    String   @default("https://maps.google.com/?q=Jombang")
  updatedAt        DateTime @updatedAt
}
